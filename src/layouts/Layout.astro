---
import Header from "../components/header/Header.astro";
import Footer from "../components/footer/Footer.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

export interface Props {
  title: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title = "", description = "" } = Astro.props;
const siteTitle = t("layout.siteTitle");
const defaultTitle = t("layout.defaultTitle");
const pageTitle = title ? `${title} | ${siteTitle}` : defaultTitle;
const pageDescription = description || t("layout.description");
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const htmlLang = lang === "hr_HR" ? "hr-HR" : "en";
const ogLocale = lang === "hr_HR" ? "hr_HR" : "en_US";
const heroImageUrl = new URL("/initial.jpg", Astro.site).href;
const logoUrl = new URL("/favicon.svg", Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${canonicalUrl}#organization`,
  name: siteTitle,
  description: pageDescription,
  url: canonicalUrl,
  image: heroImageUrl,
  logo: logoUrl,
  areaServed: {
    "@type": "Country",
    name: "Croatia",
  },
  availableLanguage: ["hr-HR", "en"],
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "customer support",
      email: "info@proplansmart.hr",
      availableLanguage: ["hr-HR", "en"],
    },
  ],
  founder: {
    "@type": "Person",
    name: "Manda Šaliċ",
  },
};
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="hr-HR" href={canonicalUrl} />

    <!-- HTML Meta Tags -->
    <meta name="generator" content={Astro.generator} />
    <meta itemprop="image" content="/logo.svg" />
    <meta name="robots" content="index, follow" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0B3D91" />
    <meta
      name="keywords"
      content="EU projekti, EU savjetovanje, pisanje projektnih prijava, poslovni planovi, ProPlan SMART, EU funding consultancy, grant applications, business plans"
    />
    <title>{pageTitle}</title>

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ProPlan SMART" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={heroImageUrl} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="proplansmart.hr" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={heroImageUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700&display=swap" as="style" />

    {/* <!-- Structured Data (Schema.org) --> */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <script is:inline>
      const currentTheme = localStorage.getItem("theme");
      switch (currentTheme) {
        case "light":
          document.querySelector("html").classList.add(currentTheme);
          break;
        case "dark":
          document.querySelector("html").classList.add(currentTheme);
          break;
        default:
          document.querySelector("html").classList.add("dark");
          break;
      }
    </script>
  </head>
  <body class="overflow-hidden overflow-y-auto bg-body font-raleway">
    <Header />
    <slot />
    <Footer />
  </body>
  <script>
    const toggleTheme = document.querySelector("[data-switch-theme]") as HTMLButtonElement;
    const html = document.querySelector("html") as HTMLHtmlElement;

    if (toggleTheme) {
      toggleTheme.addEventListener("click", () => {
        if (html.classList.contains("dark")) {
          html.classList.remove("dark");
          html.classList.add("light");
          localStorage.setItem("theme", "light");
        } else {
          html.classList.remove("light");
          html.classList.add("dark");
          localStorage.setItem("theme", "dark");
        }
      });
    }
  </script>
  <script>
    const toggleMenu = document.querySelector("[data-toggle-nav]") as HTMLButtonElement;
    const navbar = document.querySelector("[data-navbar]") as HTMLDivElement;
    const overlayNav = document.querySelector("[data-nav-overlay]") as HTMLDivElement;

    if (toggleMenu) {
      const closeNav = () => {
        toggleMenu.setAttribute("data-open-nav", "false");
        overlayNav.setAttribute("data-is-visible", "false");
        document.body.classList.remove("!overflow-y-hidden");
        navbar.style.height = "0px";
      };

      toggleMenu.addEventListener("click", () => {
        if (toggleMenu.getAttribute("data-open-nav") === "false") {
          toggleMenu.setAttribute("data-open-nav", "true");
          overlayNav.setAttribute("data-is-visible", "true");
          document.body.classList.add("!overflow-y-hidden");
          navbar.style.height = `${navbar.scrollHeight}px`;
        } else {
          closeNav();
        }
      });

      navbar.addEventListener("click", closeNav);
      overlayNav.addEventListener("click", closeNav);
    }
  </script>
</html>
<style is:global>
  :root {
    --color-bg: 255 255 255;
    --color-border: 255 255 255;
    --color-box: 255 255 255;
    --box-border: 229 231 235;
    --box-sd: 226 232 240 / 0.5;
    --heading-1: 23 37 84;
    --heading-2: 31 41 55;
    --heading-3: 55 65 81;
  }

  .dark {
    --color-bg: 3 7 18;
    --color-box: 17 24 39;
    --box-border: 243 244 246/0.1;
    --box-sd: transparent;

    --heading-1: 255 255 255;
    --heading-2: 243 244 246;
    --heading-3: 209 213 219;
  }

  [data-toggle-nav][data-open-nav="true"] #line1 {
    transform: translateY(0.375rem) rotate(40deg);
  }
  [data-toggle-nav][data-open-nav="true"] #line2 {
    transform: scaleX(0);
    opacity: 0;
  }
  [data-toggle-nav][data-open-nav="true"] #line3 {
    transform: translateY(-0.375rem) rotate(-40deg);
  }

  [data-nav-overlay][data-is-visible="true"] {
    visibility: visible;
    display: flex;
  }
</style>
